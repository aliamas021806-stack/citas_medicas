<?xml version="1.0" encoding="utf-8"?>
<!--
  Cabecera de sección de la agenda del médico.
  Separa «Pendientes de atender» de «Ya atendidas» dentro de la misma lista, para que
  lo que aún hay que hacer quede siempre por encima del histórico del día.
-->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tvTituloSeccion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="@dimen/spacing_xs"
    android:paddingTop="@dimen/spacing_md"
    android:paddingBottom="@dimen/spacing_xs"
    android:textAppearance="@style/TextAppearance.CitasMedicas.Subtitle"
    android:textColor="@color/text_secondary"
    android:textSize="13sp"
    android:textStyle="bold" />
